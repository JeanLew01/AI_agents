# Python environments, caches
*-env/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Cloned upstream repositories (own git history; re-clone at the pinned commit given in the reports)
paper2agent/*/mcp-build/*/repo/
paper2agent/ParticleFilter/mcp-build/DiffPF-source-inspection/

# Regenerable intermediates
paper2agent/*/staging/
paper2agent/*/paper-review/_scratch/
paper2agent/*/mcp-build/*/tmp/
paper2agent/Diffusion/mcp-build/LLaDA-source-inspection/

# Personal, kept local only: brainstorm runs, the mechanism cards scouts write during them,
# and the World_Model collection (publisher's copy of the IJRR 2026 survey, not redistributable)
brainstorm/sessions/
brainstorm/library/cards/
paper2agent/World_Model/
