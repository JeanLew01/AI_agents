    "diffres_run_lgssm_particle_filter": {
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_path": {
            "description": "JSON file with LGSSM matrices F (dx,dx), Q (dx,dx), H (dy,dx), R (dy,dy), m0 (dx), P0 (dx,dx): x_k = F x_{k-1} + N(0,Q), y_k = H x_k + N(0,R), x_0 ~ N(m0,P0)",
            "type": "string"
          },
          "observations_path": {
            "description": ".npz file with 'ys' of shape (T+1, dy); ys[0] is the time-0 observation ((T+1,) is accepted when dy = 1)",
            "type": "string"
          },
          "nparticles": {
            "default": 32,
            "description": "Number of particles N (upstream LGSSM experiments use 32, tests 1000)",
            "type": "integer"
          },
          "resampling_method": {
            "default": "diffusion",
            "description": "Resampler used inside the SMC",
            "enum": [
              "diffusion",
