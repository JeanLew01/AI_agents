              "stratified",
              "systematic",
              "multinomial_stopped",
              "ensemble_ot",
              "soft",
              "gumbel_softmax"
            ],
            "type": "string"
          },
          "resampling_threshold": {
            "default": 1.0,
            "description": "Resample when ESS < threshold * N; 1.0 (upstream default) resamples at every step, 0 never resamples",
            "type": "number"
          },
          "diffusion_a": {
            "default": -0.5,
            "description": "diffusion: negative forward noising coefficient a",
            "type": "number"
          },
          "diffusion_T": {
            "default": 3.0,
            "description": "diffusion: terminal time T (default 3 as experiments/lgssm; tests/test_filters.py uses 2)",
            "type": "number"
          },
          "diffusion_steps": {
            "default": 8,
            "description": "diffusion: number of integration steps K, ts = linspace(0, T, K+1) (default 8 as experiments/lgssm; tests/test_filters.py uses 7)",
            "type": "integer"
          },
          "diffusion_integrator": {
            "default": "euler",
            "description": "diffusion: integrator ('tweedie' needs ode=false, 'diffrax' needs ode=true)",
            "enum": [
              "euler",
              "lord_and_rougemont",
              "jentzen_and_kloeden",
              "tweedie",
              "diffrax"
            ],
            "type": "string"
          },
          "diffusion_ode": {
            "default": true,
            "description": "diffusion: true = probability-flow ODE, false = reverse SDE",
            "type": "boolean"
          },
          "diffusion_jitter": {
            "default": 0.0,
            "description": "diffusion: jitter added to the reference variance (gradient demo uses 1e-5)",
            "type": "number"
          },
          "ot_eps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ensemble_ot: entropic regulariser; null uses the upstream default 1/log(N)"
          },
          "ot_implicit_diff": {
            "default": false,
            "description": "ensemble_ot: implicit differentiation of Sinkhorn; default false (unrolled) as experiments/lgssm/ot.py, whereas the upstream function default and tests/test_filters.py use true; forward values are the same",
            "type": "boolean"
          },
          "soft_alpha": {
            "default": 0.5,
            "description": "soft: softening parameter alpha in [0, 1] (1 = no softening)",
            "type": "number"
          },
          "gumbel_tau": {
            "default": 0.5,
            "description": "gumbel_softmax: positive temperature tau",
            "type": "number"
          },
          "seed": {
            "default": 0,
            "description": "Seed for jax.random.PRNGKey(seed)",
            "type": "integer"
          },
          "prng_key": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional raw PRNGKey data (two uint32 values) used instead of seed"
          },
          "save_particle_path": {
            "default": false,
            "description": "Also save particles and log-weights of all T+1 steps (else final step only)",
            "type": "boolean"
          },
          "compute_gradient": {
            "default": false,
            "description": "Also compute the gradient of nll w.r.t. F and H by jax.value_and_grad",
            "type": "boolean"
          },
          "compare_to_kalman": {
