 "tool_schemas": {
  "diffres_resample_particles_diffusion": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "particles_path": {
     "description": ".npz with 'samples' (N, ...) float and exactly one of 'log_weights' (N,) or 'weights' (N,); weights are normalised before resampling; memory grows as N^2 x (sample size) float64 per integration step, so keep N to a few thousand",
     "type": "string"
    },
    "a": {
     "default": -2.0,
     "description": "Mean-reverting coefficient of the Ornstein-Uhlenbeck reference process; must be negative (more negative = faster mixing towards the empirical Gaussian reference); default -2 from demos/gaussian_mixture.ipynb (gms experiments use -1)",
     "type": "number"
    },
    "T": {
     "default": 1.0,
     "description": "Terminal diffusion time T > 0; ts = linspace(0, T, nsteps + 1) as in every upstream caller; default 1.0 from the demo notebook",
     "type": "number"
    },
    "nsteps": {
     "default": 32,
     "description": "Number of integration steps K >= 1; default 32 from the demo notebook",
     "type": "integer"
    },
    "integrator": {
     "default": "euler",
     "description": "Integrator of the reverse dynamics; 'diffrax' (diffrax Euler solver) requires ode=True and 'tweedie' requires ode=False; default 'euler' from the upstream signature (the demo notebook uses 'jentzen_and_kloeden')",
     "enum": [
      "euler",
      "lord_and_rougemont",
      "jentzen_and_kloeden",
      "diffrax",
      "tweedie"
     ],
     "type": "string"
    },
    "ode": {
     "default": true,
     "description": "True: probability-flow ODE (deterministic given the initial reference draw); False: reverse SDE; default True from the upstream signature",
     "type": "boolean"
    },
    "jitter": {
     "default": 0.0,
     "description": "Non-negative value added to the reference variances for numerical stability (e.g. a dimension with zero weighted variance); upstream default 0",
     "type": "number"
    },
    "seed": {
     "default": 0,
     "description": "Seed for jax.random.PRNGKey(seed); ignored when prng_key is given",
     "type": "integer"
    },
    "prng_key": {
     "anyOf": [
      {
       "items": {
        "type": "integer"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Optional raw PRNG key (two uint32 values) used instead of seed, e.g. to reproduce a run with a split key"
    },
    "output_dir": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Base output directory; a fresh unique subdirectory is created per call (default <project>/tmp/outputs/<tool>)"
    }
