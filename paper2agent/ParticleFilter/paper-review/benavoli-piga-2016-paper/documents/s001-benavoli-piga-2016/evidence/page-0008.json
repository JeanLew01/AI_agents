        202.9525146484375,
        437.5293273925781,
        235.7594757080078
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "X",
      "bbox": [
        437.5199890136719,
        223.6094512939453,
        443.224609375,
        230.58331298828125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "dP(x) = 1",
      "bbox": [
        446.4000549316406,
