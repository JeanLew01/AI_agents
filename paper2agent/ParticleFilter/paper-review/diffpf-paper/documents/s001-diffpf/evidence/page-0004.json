      ]
    },
    {
      "text": "baselines, including DeepSSM, AESMC-Bootstrap, AESMC,",
      "bbox": [
        311.97808837890625,
        715.2182006835938,
        563.03564453125,
        724.124755859375
      ],
      "direction": [
