        438.2325744628906,
        137.731201171875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "pθ.x1:T |y1:T / is replaced by sampling from an SMC approximation ˆpθ.x1:T |y1:T / does not admit",
