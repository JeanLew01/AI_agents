        42.710052490234375,
        188.2717742919922,
        438.23065185546875,
        199.15618896484375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "survive all the resampling steps, whereas the remaining N −1 particles are generated as usual.",
