        103.74873352050781,
        438.2315673828125,
        115.36038208007812
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "typically impossible and we investigate the possibility of using a particle approximation to this",
      "bbox": [
