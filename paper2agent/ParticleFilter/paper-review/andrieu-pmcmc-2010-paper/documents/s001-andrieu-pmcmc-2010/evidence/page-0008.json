        42.710845947265625,
        393.71990966796875,
        438.22784423828125,
        405.33160400390625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "suggests the use of the standard ‘auxiliary variables trick’ by embedding the sampling from",
