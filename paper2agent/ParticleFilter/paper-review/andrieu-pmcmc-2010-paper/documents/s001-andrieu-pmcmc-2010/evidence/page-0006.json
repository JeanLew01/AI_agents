        244.17379760742188,
        92.85238647460938,
        257.9919738769531,
        100.50727844238281
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "ˆpθ.yn|y1:n−1/",
      "bbox": [
        259.4612731933594,
        81.47322082519531,
        314.8939514160156,
        93.3984146118164
      ],
