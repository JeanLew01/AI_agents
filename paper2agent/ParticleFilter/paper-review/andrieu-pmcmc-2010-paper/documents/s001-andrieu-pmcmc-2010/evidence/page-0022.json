        158.9195098876953,
        340.5070495605469,
        168.99169921875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Qn ={x1:n ∈X n :πn−1.x1:n−1/ Mn.xn|x1:n−1/>0}",
