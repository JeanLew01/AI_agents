        42.710418701171875,
        207.53456115722656,
        118.49591827392578,
        216.7698974609375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Assumption 1. For n=1, . . . ,P, we have Sn ⊆Qn.",
