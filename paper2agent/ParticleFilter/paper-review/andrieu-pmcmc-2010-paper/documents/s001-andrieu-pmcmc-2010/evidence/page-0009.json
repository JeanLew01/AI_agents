        336.2460021972656,
        443.6086730957031,
        347.85760498046875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "the marginal likelihood pθ.y1:T / are needed, their SMC approximation counterparts are used",
      "bbox": [
