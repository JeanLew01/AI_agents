        612.6658935546875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "almost surely,",
      "bbox": [
        292.1661071777344,
        603.6396484375,
        344.9064636230469,
        611.9514770507812
      ],
      "direction": [
