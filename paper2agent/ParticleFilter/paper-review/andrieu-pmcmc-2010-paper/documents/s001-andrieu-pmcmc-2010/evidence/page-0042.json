        394.11590576171875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "E.Ln/=ln ↗s",
      "bbox": [
        168.33303833007812,
        402.37664794921875,
        220.46505737304688,
        412.68817138671875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "and",
      "bbox": [
        230.09228515625,
        403.1300354003906,
        244.47438049316406,
        411.44189453125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "E.Un/=un ↘s;",
      "bbox": [
        254.03884887695312,
        402.3768615722656,
        312.60382080078125,
        412.68817138671875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": ".48/",
      "bbox": [
        422.5632629394531,
        403.1300354003906,
        438.2275695800781,
        411.44189453125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "P.Ln−1 ⩽Ln/=1",
      "bbox": [
        157.994384765625,
        419.70263671875,
        222.3007354736328,
        430.0142517089844
      ],
      "direction": [
        1.0,
