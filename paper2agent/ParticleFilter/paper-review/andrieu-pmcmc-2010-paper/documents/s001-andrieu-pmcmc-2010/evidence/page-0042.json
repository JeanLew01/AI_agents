        395.3621520996094
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "for every n=1, 2, . . . ;",
      "bbox": [
        295.0668640136719,
        385.0508728027344,
        375.84698486328125,
        394.11590576171875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": ".47/",
      "bbox": [
