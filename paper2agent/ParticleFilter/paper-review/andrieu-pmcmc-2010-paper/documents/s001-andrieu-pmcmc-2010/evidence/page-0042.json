        438.2275085449219,
        428.76800537109375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Let",
      "bbox": [
        42.709747314453125,
        435.3457336425781,
        55.603431701660156,
        443.6575927734375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "F0 ={∅, Ω},",
      "bbox": [
        217.4236297607422,
        449.1097717285156,
        264.0282287597656,
        459.42108154296875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Fn =σ{Ln, Un},",
      "bbox": [
        210.2513427734375,
        462.0608215332031,
        271.1722106933594,
        472.37255859375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Fk,n =σ{Fk, Fk+1, . . . , Fn}",
      "bbox": [
        162.42950439453125,
        475.0122375488281,
        263.60162353515625,
        485.323974609375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "k ⩽n:",
      "bbox": [
        297.0749816894531,
        475.0126647949219,
        318.50555419921875,
        483.97906494140625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Under these assumptions we can use the following algorithm 3.",
      "bbox": [
        42.708953857421875,
        492.6997985839844,
        281.9145202636719,
        501.01165771484375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Step 1: simulate G0 ∼U.0, 1/; set n=1.",
      "bbox": [
        51.67535400390625,
        509.3366394042969,
        198.6178741455078,
        519.64794921875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Step 2: obtain Ln and Un given F0,n−1:",
      "bbox": [
