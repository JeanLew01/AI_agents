        459.27008056640625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "linear previsions, which we denote by M(E",
      "bbox": [
        312.0001525878906,
        459.105712890625,
        493.952392578125,
        478.1443176269531
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "ZO(·|ZU)),i.e., if",
      "bbox": [
        494.5199890136719,
        459.1056213378906,
        563.0494384765625,
        478.14422607421875
      ],
      "direction": [
        1.0,
        0.0
      ]
