        257.569580078125,
        300.061279296875,
        270.8597412109375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "longer the case when imprecision enters the picture: a CLP is",
      "bbox": [
        48.959869384765625,
        269.569580078125,
        300.03594970703125,
        282.8597412109375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
