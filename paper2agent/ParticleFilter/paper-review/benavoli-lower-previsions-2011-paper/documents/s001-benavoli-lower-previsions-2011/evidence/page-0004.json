        420.5962219238281,
        321.3208923339844,
        434.9822692871094,
        351.2984924316406
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "zO∈ZO",
      "bbox": [
        414.4762878417969,
        337.9488525390625,
        440.57183837890625,
        345.1601867675781
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "f(zO)pZO(zO).",
      "bbox": [
