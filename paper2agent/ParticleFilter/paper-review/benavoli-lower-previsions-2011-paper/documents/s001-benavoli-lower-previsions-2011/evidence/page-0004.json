        563.238037109375,
        442.26422119140625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "tional lower prevision on the set of gambles L(ZO∪U), if it is",
      "bbox": [
        312.0001220703125,
        434.20941162109375,
        563.0752563476562,
        454.26422119140625
      ],
      "direction": [
        1.0,
        0.0
      ]
