        618.5443115234375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "(SC1) E",
      "bbox": [
        321.96063232421875,
        613.2493286132812,
        357.3931579589844,
        626.5394897460938
      ],
      "direction": [
