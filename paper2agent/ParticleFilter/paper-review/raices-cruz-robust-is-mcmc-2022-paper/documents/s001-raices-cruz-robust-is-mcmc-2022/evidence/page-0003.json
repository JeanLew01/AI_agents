        73.44099426269531,
        110.04499816894531,
        501.872802734375,
        118.89179229736328
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "MCMC sampler, which leads to fewer MCMC runs to cover the hyperparameter space.",
