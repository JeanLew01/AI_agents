        48.95994567871094,
        236.18939208984375,
        300.24951171875,
        249.47955322265625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "functions used for the importance sampling. A high level of",
      "bbox": [
        48.95994567871094,
        248.18939208984375,
        300.0774230957031,
        261.47955322265625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
