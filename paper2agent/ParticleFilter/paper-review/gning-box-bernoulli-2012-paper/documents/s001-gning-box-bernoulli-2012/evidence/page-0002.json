      "bbox": [
        321.9585876464844,
        164.42913818359375,
        563.1685791015625,
        177.71929931640625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "RFS on X. A Bernoulli RFS has a probability q of being a",
      "bbox": [
        311.9987487792969,
        176.42913818359375,
        563.0223388671875,
        189.71929931640625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "singleton whose only element is distributed according to the",
      "bbox": [
        311.99853515625,
        188.30926513671875,
        563.0219116210938,
        201.59942626953125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
