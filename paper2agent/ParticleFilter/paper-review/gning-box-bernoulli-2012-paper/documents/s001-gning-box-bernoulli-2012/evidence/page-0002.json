      "text": "pdf s(x) deﬁned on X and a probability 1−q of being empty.",
      "bbox": [
        311.9985046386719,
        200.30926513671875,
        563.2498168945312,
        213.59942626953125
      ],
      "direction": [
        1.0,
        0.0
      ]
