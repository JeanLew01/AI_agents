        563.2203369140625,
        225.47955322265625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "as",
      "bbox": [
        311.99798583984375,
        224.18939208984375,
        320.31341552734375,
        237.47955322265625
      ],
      "direction": [
        1.0,
        0.0
