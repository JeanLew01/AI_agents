        427.4696044921875,
        100.53046417236328,
        440.759765625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "In this paper, we develop and compare the performance",
      "bbox": [
        58.91973114013672,
        439.4696044921875,
        300.4627990722656,
        452.759765625
      ],
      "direction": [
        1.0,
        0.0
      ]
