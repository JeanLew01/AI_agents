        343.4908752441406
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "1 −∆k+1",
      "bbox": [
        423.9598388671875,
        324.63934326171875,
        463.8077697753906,
        335.543701171875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "1 −∆k+1 · qk+1|k",
      "bbox": [
        407.2799987792969,
        338.198974609375,
        480.3932800292969,
        349.85089111328125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "· qk+1|k,",
      "bbox": [
        484.5601501464844,
        331.4790344238281,
        518.5198364257812,
        342.7435302734375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "(7)",
      "bbox": [
        551.4000244140625,
        328.70941162109375,
        563.1176147460938,
        341.99957275390625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "where",
      "bbox": [
        312.0000305175781,
        351.74920654296875,
        336.4634094238281,
        365.03936767578125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "∆k+1 = pD",
      "bbox": [
        318.3601989746094,
        381.2881774902344,
        365.5243225097656,
        392.690673828125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "",
      "bbox": [
        367.8000183105469,
        368.2217712402344,
        376.517333984375,
        398.1993713378906
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "1 −",
      "bbox": [
        367.8000183105469,
        381.03912353515625,
        391.50115966796875,
        416.0794677734375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "X",
      "bbox": [
        404.3999938964844,
        378.7819519042969,
        418.7860412597656,
        408.7595520019531
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "[z]∈Υk+1",
      "bbox": [
        393.7198791503906,
        395.70623779296875,
        428.9070739746094,
        405.0054931640625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "R",
      "bbox": [
        432.2398681640625,
        372.78192138671875,
        436.9422302246094,
        402.759521484375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "gk+1([z]|x) sk+1|k(x) dx",
      "bbox": [
        440.51995849609375,
        373.5988464355469,
        542.0772705078125,
        384.86334228515625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "λ c([z])",
      "bbox": [
        472.20001220703125,
        388.1280212402344,
        502.22479248046875,
        398.0906677246094
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "",
      "bbox": [
        543.4801635742188,
        368.2217712402344,
        552.1974487304688,
        398.1993713378906
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": ".",
      "bbox": [
        543.4801635742188,
        381.2881774902344,
        556.5596923828125,
        416.0794677734375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "(8)",
      "bbox": [
        551.4000244140625,
        401.9093017578125,
        563.1176147460938,
        415.199462890625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "The quantity ∆k+1 can be positive or negative and can be",
      "bbox": [
        312.0000305175781,
        413.7893981933594,
        563.144775390625,
        428.5194091796875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "interpreted as 1 −Λk+1, where Λk+1 is the measurement",
      "bbox": [
        312.0001220703125,
        425.7893981933594,
        563.2899169921875,
        440.5194091796875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "likelihood ratio under the assumptions of target existence",
      "bbox": [
        312.000244140625,
        437.7893981933594,
        563.14306640625,
        451.0795593261719
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "and non-existence. Quantity gk+1([z]|x) in (8) represents the",
      "bbox": [
        312.000244140625,
        449.66949462890625,
        563.0237426757812,
        463.3434753417969
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "generalized likelihood function at time k + 1 for a target",
      "bbox": [
        312.00054931640625,
        461.66949462890625,
        563.1694946289062,
        474.95965576171875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "originated interval measurement. Furthermore λ and c([z])",
      "bbox": [
        312.00128173828125,
        473.5491943359375,
        562.9463500976562,
        486.83935546875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "have already been deﬁned as false alarm parameters. The",
      "bbox": [
        312.001220703125,
        485.5491943359375,
        563.1439208984375,
        498.83935546875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "generalized likelihood is further discussed in Sec. III-B.",
      "bbox": [
        312.001220703125,
        497.5491943359375,
        545.0117797851562,
        510.83935546875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "The target spatial pdf is updated as follows:",
      "bbox": [
        321.9613952636719,
        509.30938720703125,
        502.6910095214844,
        522.5995483398438
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "sk+1|k+1(x) =",
      "bbox": [
        316.3211669921875,
        548.3280639648438,
        377.10205078125,
        559.343505859375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "1 −pD + pD",
      "bbox": [
        381.1212463378906,
        530.3187866210938,
        432.24554443359375,
        541.9707641601562
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "P",
      "bbox": [
        447.1212463378906,
        530.1018676757812,
        457.6318359375,
        560.0794067382812
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "[z]∈Υk+1",
      "bbox": [
        434.521240234375,
        542.106201171875,
        469.70843505859375,
        551.4050903320312
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "gk+1([z]|x)",
      "bbox": [
        473.0412292480469,
        527.8895874023438,
        511.7918395996094,
        535.4453735351562
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "λc([z])",
      "bbox": [
        480.8399963378906,
        536.2896118164062,
        503.87060546875,
        543.2634887695312
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "1 −∆k+1",
      "bbox": [
        426.7200012207031,
        554.9189453125,
        466.5683288574219,
        565.8236694335938
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "sk+1|k(x).",
      "bbox": [
        515.7603149414062,
        548.3281860351562,
        558.5996704101562,
        559.3435668945312
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "(9)",
      "bbox": [
        551.4002075195312,
        561.269287109375,
        563.1177978515625,
        574.5594482421875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "In the special case where the detection process is perfect, i.e.",
      "bbox": [
        312.0002136230469,
        573.269287109375,
        563.0108642578125,
        586.5594482421875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "pD = 1 and there are no false detections, the measurement",
      "bbox": [
        312.00018310546875,
        585.1493530273438,
        563.2901000976562,
        599.5709228515625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "set becomes a singleton Υk+1 = {[z]}, containing only the",
      "bbox": [
        312.0002136230469,
        597.1493530273438,
        563.023681640625,
        611.5709228515625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "target originated measurement. Then it is easy to verify that",
      "bbox": [
        312.0003662109375,
        609.1493530273438,
        563.0499877929688,
        622.4395141601562
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "λc([z]) terms cancel out in (7) and (9). Furthermore, with",
      "bbox": [
        312.0003967285156,
        621.0294799804688,
        562.9813232421875,
        634.3196411132812
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "pB = 0, pS = 1 and q0|0 = 1, the Bernoulli ﬁlter for interval",
      "bbox": [
        312.0003356933594,
        633.0294799804688,
        563.1695556640625,
        647.810791015625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "measurements simpliﬁes to the single-target Bayes ﬁlter for",
      "bbox": [
        312.0001525878906,
        644.9096069335938,
        563.1177368164062,
        658.1997680664062
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "interval measurements (its update equation given in [p.159]",
      "bbox": [
        312.00018310546875,
        656.9096069335938,
        563.3587646484375,
        670.1997680664062
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "[10]). For the more general case of pD(x) and pS(x), the",
      "bbox": [
        312.00018310546875,
        668.9096069335938,
        563.0233764648438,
        682.1997680664062
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Bernoulli ﬁlter equations can be found in [10, Sec.14.7].",
      "bbox": [
        311.9998779296875,
        680.7896728515625,
        544.8909912109375,
        694.079833984375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "The proposed Bernoulli ﬁlter is the optimal Bayes ﬁlter for",
      "bbox": [
        321.9600524902344,
        692.5494995117188,
        563.1178588867188,
        705.8396606445312
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "the considered problem. In the general case, however, it has",
      "bbox": [
        311.9998779296875,
        704.5494995117188,
        563.0748901367188,
        717.8396606445312
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "no analytic solution and this paper will develop two numerical",
      "bbox": [
        311.9998779296875,
        716.5494995117188,
        563.28955078125,
        729.8396606445312
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "implementations.",
      "bbox": [
        311.9998779296875,
        728.4295654296875,
        381.21063232421875,
        741.7197265625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "B. Generalized Likelihood",
      "bbox": [
        311.9998779296875,
        760.1656494140625,
        420.1811828613281,
        772.330078125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "The update equations (7) and (9) are different from those",
      "bbox": [
        321.9600524902344,
        774.1494750976562,
        563.1430053710938,
        787.4396362304688
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "in the standard Bernoulli ﬁlter in the sense that the standard",
      "bbox": [
        311.9998779296875,
        786.029541015625,
        563.22119140625,
        799.3197021484375
      ],
      "direction": [
        1.0,
        0.0
      ]
    }
  ],
