        503.9974365234375,
        709.0859375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "achieve the desired objective.",
      "bbox": [
        108.0,
        711.08837890625,
        225.060546875,
        719.9949340820312
      ],
      "direction": [
        1.0,
