    {
      "text": "between 1 and 10 milliseconds, resulting in feedback rates",
      "bbox": [
        313.199951171875,
        631.7254638671875,
        558.0009765625,
        640.6320190429688
      ],
      "direction": [
        1.0,
        0.0
      ]
