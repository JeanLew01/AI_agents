    {
      "text": "between 100-1000 Hz.",
      "bbox": [
        313.199951171875,
        643.680419921875,
        405.66278076171875,
        652.5869750976562
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Note that Fig. 3 provides some insight into relative per-",
      "bbox": [
