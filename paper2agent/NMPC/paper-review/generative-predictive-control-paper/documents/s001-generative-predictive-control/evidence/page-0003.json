        459.560546875,
        351.8288879394531
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "¯Uk ←¯Uk−1 + σ2∇¯Uk−1 log pσ( ¯Uk−1 | xk−1) .",
