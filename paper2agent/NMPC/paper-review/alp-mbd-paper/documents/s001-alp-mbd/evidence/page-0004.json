        53.99999237060547,
        642.7863159179688,
        298.8009033203125,
        651.69287109375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "more compatible with adaptive parameter learning, enabling",
      "bbox": [
        53.99999237060547,
        654.7413330078125,
        298.8009948730469,
        663.6478881835938
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "the design of Adaptive LP-MBD (ALP-MBD).",
      "bbox": [
        53.99999237060547,
        666.6962890625,
        245.64051818847656,
        675.6028442382812
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "A. Formulation as a Reinforcement Learning Problem",
      "bbox": [
        53.99999237060547,
        685.7439575195312,
        276.2854919433594,
        694.3317260742188
