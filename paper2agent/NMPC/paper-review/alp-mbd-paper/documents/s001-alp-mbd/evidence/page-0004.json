      "bbox": [
        53.99998474121094,
        142.221435546875,
        298.801025390625,
        151.12799072265625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "interdependence complicates the tuning process and makes it",
