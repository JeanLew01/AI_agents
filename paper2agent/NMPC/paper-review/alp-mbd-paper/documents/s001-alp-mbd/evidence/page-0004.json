      "bbox": [
        63.96298599243164,
        190.075439453125,
        298.80133056640625,
        198.98199462890625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "rameters: the maximum noise scale σmax and the number",
      "bbox": [
        53.99998474121094,
        201.8710479736328,
        298.7979431152344,
        212.4310302734375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "of diffusion steps T. These parameters are decoupled and",
      "bbox": [
        53.99998474121094,
        213.82606506347656,
        298.8009948730469,
        222.89202880859375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
