        298.80108642578125,
        270.71307373046875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "This structural simplicity makes the noise schedule not only",
      "bbox": [
        54.0,
        273.7615051269531,
        298.8009948730469,
        282.6680603027344
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
