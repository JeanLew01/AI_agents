      "text": "In VP-MBD, the diffusion steps and noise scheduling",
      "bbox": [
        63.9630012512207,
        391.6944274902344,
        298.8013610839844,
        400.6009826660156
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
