      "bbox": [
        54.0,
        285.71649169921875,
        298.801025390625,
        294.623046875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "providing an intuitive understanding of the interpolation",
      "bbox": [
        54.0,
        297.6714782714844,
        298.8009338378906,
        306.5780334472656
      ],
      "direction": [
        1.0,
        0.0
      ]
