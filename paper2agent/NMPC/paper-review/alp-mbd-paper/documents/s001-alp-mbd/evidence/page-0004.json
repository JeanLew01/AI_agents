        298.79937744140625,
        236.341064453125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "the maximum variance of the Gaussian proposal, while",
      "bbox": [
        54.0,
        237.8955078125,
        298.8009948730469,
        246.80206298828125
      ],
      "direction": [
        1.0,
        0.0
      ]
