        53.99998474121094,
        154.17645263671875,
        298.801025390625,
        163.0830078125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "difficult to isolate the effect of each parameter on exploration",
      "bbox": [
        53.99998474121094,
        166.1324462890625,
        298.8009338378906,
        175.03900146484375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "and refinement.",
      "bbox": [
        53.99998474121094,
        178.08746337890625,
        116.97356414794922,
        186.9940185546875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
