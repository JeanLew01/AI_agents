        563.035400390625,
        700.6918334960938
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "the obscured obstacles until the system was too close to",
      "bbox": [
        311.97796630859375,
        703.6212768554688,
