        311.9779968261719,
        585.2953491210938,
        563.0355834960938,
        594.201904296875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "dynamics and sensor model previously described were used",
      "bbox": [
        311.9779968261719,
        597.13134765625,
