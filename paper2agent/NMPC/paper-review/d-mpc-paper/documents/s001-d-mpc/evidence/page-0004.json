        680.0488891601562,
        540.224365234375,
        690.011474609375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "diffusion dynamics model, differing from our goal of planning with learned dynamics and action proposals.",
      "bbox": [
        72.0,
        692.00390625,
