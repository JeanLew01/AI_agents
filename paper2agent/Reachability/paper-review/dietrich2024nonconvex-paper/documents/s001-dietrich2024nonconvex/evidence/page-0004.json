        153.42864990234375,
        250.6010284423828,
        163.18138122558594
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "θ ∈",
      "bbox": [
        260.56298828125,
        152.6431884765625,
        276.2943420410156,
        162.94137573242188
      ],
