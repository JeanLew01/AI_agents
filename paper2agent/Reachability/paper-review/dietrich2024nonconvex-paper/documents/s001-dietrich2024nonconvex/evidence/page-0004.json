        226.9949951171875,
        138.7628173828125,
        230.9481658935547,
        145.84027099609375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Vol(θ)",
      "bbox": [
        260.56298828125,
        129.2451171875,
        289.4296569824219,
        139.1724090576172
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "subject to",
      "bbox": [
