      "bbox": [
        229.1379852294922,
        138.73870849609375,
        279.0167236328125,
        153.46835327148438
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "n . For d ∈N, we consider R[X]n",
