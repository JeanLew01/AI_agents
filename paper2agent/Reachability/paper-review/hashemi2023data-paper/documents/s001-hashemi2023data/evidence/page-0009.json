        209.9341583251953,
        539.8635864257812,
        222.08689880371094
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "for training a surrogate ReLU model was 2 hours and the run-time for test data-generation was 122",
      "bbox": [
