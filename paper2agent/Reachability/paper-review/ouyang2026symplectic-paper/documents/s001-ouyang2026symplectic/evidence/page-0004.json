        257.13873291015625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "i.e., T ⋆",
      "bbox": [
        313.199951171875,
        256.2431945800781,
        345.23663330078125,
        266.84991455078125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "ϵ (x) := infu∈U Tϵ(x, u). This leads to our final",
      "bbox": [
        339.7739562988281,
        257.7839660644531,
        558.0191040039062,
        269.09375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "requirement.",
      "bbox": [
        313.199951171875,
        269.89935302734375,
        363.8298645019531,
        278.805908203125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Assumption 5 (Uniform Positive Energy Decrease Rate).",
      "bbox": [
        313.199951171875,
        287.4767761230469,
        558.0009765625,
        296.5028991699219
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "There exists ϵ > 0 such that",
      "bbox": [
        313.199951171875,
        299.3919372558594,
        427.87945556640625,
        308.23870849609375
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "vϵ :=",
      "bbox": [
        382.60394287109375,
        318.0719299316406,
        404.5395202636719,
        328.4126892089844
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "inf",
      "bbox": [
        419.50335693359375,
        318.07196044921875,
        430.8607177734375,
        326.9187316894531
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "x∈X\\Hϵ",
