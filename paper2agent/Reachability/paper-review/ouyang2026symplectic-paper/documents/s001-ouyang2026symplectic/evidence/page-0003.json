        178.977294921875,
        558.0009765625,
        187.88385009765625
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "default fall-back option. For each x ∈X, define ρK(x) :=",
      "bbox": [
        313.199951171875,
        190.21597290039062,
        558.0122680664062,
        200.5348663330078
      ],
      "direction": [
        1.0,
