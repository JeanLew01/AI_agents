        214.72305297851562,
        417.60791015625,
        224.346923828125
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "ιK(x) :=",
      "bbox": [
        339.8700256347656,
        245.6599884033203,
        376.72265625,
        255.4209747314453
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "",
      "bbox": [
        379.4760437011719,
