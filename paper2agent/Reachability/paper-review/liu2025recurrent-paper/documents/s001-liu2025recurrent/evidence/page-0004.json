    },
    {
      "text": "be continuous. If ∃a1, a2 > 0 such that",
      "bbox": [
        313.2000427246094,
        147.79205322265625,
        473.659423828125,
        165.07716369628906
      ],
      "direction": [
        1.0,
        0.0
      ]
