	grants = {1544771},
	journal = {IEEE Transactions on Automatic Control},
	keywords = {Power Networks},
	month = {12},
	number = {12},
	pages = {6294-6309},
	title = {Optimal load-side control for frequency regulation in smart grids},
	url = {http://mallada.ece.jhu.edu/pubs/2017-TAC-MZL.pdf},
	volume = {62},
	year = {2017},
