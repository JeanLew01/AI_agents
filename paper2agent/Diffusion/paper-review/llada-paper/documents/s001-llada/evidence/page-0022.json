    {
      "text": "where m is a mask sequence of the same length as p0 and w is a tunable hyperparameter that controls",
      "bbox": [
        107.64099884033203,
        279.198974609375,
        504.0030212402344,
        289.7589111328125
      ],
      "direction": [
        1.0,
        0.0
      ]
