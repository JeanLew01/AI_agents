      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "Chinese understanding: CMMLU [123] and C-Eval [124].",
      "bbox": [
        108.0,
        582.1668090820312,
        348.2779235839844,
        591.1929321289062
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "For all the aforementioned benchmarks, we follow the widely adopted evaluation process [125] used in",
      "bbox": [
        108.0,
        598.6753540039062,
        504.002197265625,
        607.5819091796875
      ],
      "direction": [
        1.0,
        0.0
      ]
